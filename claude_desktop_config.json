// MCP_Automation_Framework with cursor and claude desktop stdio
{
  "mcpServers": {
    "MCP_Automation_Test": {
      "command": "uv",
      "args": [
        "--directory",
        "D:/models_context_protocol/MCP_Server_SSE/mcp-server-automation-framework",
        "run",
        "main.py",
        "--transport",
        "stdio"
      ]
    }
  }
}

// MCP_Automation_Test with cursor sse
{
  "mcpServers": {
    "MCP_Automation_Test": {
      "url": "http://localhost:5001/sse"
    }
  }
}

// MCP_Automation_Framework with claude desktop sse
{
  "mcpServers": {
    "MCP_Automation_Framework": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "http://localhost:5001/sse"
      ]
    }
  }
}